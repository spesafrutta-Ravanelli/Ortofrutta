{
  "name": "ortofrutta-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sito web per rivendita ortofrutticola - Vue 3 + Vite + Pinia",
  "scripts": {
    "dev": "vite --force",
    "dev:clean": "npm run clean:cache && vite --force",
    "build": "vite build",
    "build:simple": "vite build --config vite.config.simple.js",
    "build:vercel": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf node_modules dist node_modules/.vite",
    "clean:cache": "powershell -ExecutionPolicy Bypass -File clean-cache.ps1",
    "fix": "powershell -ExecutionPolicy Bypass -File fix-build.ps1",
    "images:webp": "node scripts/convert-to-webp.mjs",
    "images:webp:patch": "node scripts/convert-to-webp.mjs --patch-only"
  },
  "dependencies": {
    "firebase": "^12.9.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.3",
    "sass": "^1.70.0",
    "sharp": "^0.34.5",
    "terser": "^5.46.0",
    "vite": "^5.0.12"
  }
}
